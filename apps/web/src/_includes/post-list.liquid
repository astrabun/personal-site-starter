{%- comment -%}
	Usage:
		{% assign posts = collections.posts | newestFirst %}
		{% include "post-list.liquid", posts: posts %}
{%- endcomment -%}
{%- if posts.size > 0 -%}
<ul class="post-list">
	{%- for post in posts -%}
	<li>
		<time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
		<a href="{{ post.url }}">{{ post.data.title }}</a>
	</li>
	{%- endfor -%}
</ul>
{%- else -%}
<p>No posts yet.</p>
{%- endif -%}
