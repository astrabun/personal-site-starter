{%- comment -%}
	SEO and social sharing tags. Every value comes from `seo`, which is computed
	for each page in config/seo.ts from front matter and src/_data/site.yml.
	Front matter you can set on any page: description, image, imageAlt,
	noindex. Posts can also set `updated`.
{%- endcomment -%}
<meta name="description" content="{{ seo.description | escape }}">
<link rel="canonical" href="{{ seo.url }}">
{%- if seo.noindex %}
<meta name="robots" content="noindex">
{%- endif %}
{%- for link in site.author.links %}
<link rel="me" href="{{ link }}">
{%- endfor %}

<meta property="og:site_name" content="{{ site.title | escape }}">
<meta property="og:locale" content="{{ seo.locale }}">
<meta property="og:type" content="{{ seo.type }}">
<meta property="og:title" content="{{ seo.title | escape }}">
<meta property="og:description" content="{{ seo.description | escape }}">
<meta property="og:url" content="{{ seo.url }}">
{%- if seo.image %}
<meta property="og:image" content="{{ seo.image.url }}">
<meta property="og:image:alt" content="{{ seo.image.alt | escape }}">
{%- if seo.image.width and seo.image.height %}
<meta property="og:image:width" content="{{ seo.image.width }}">
<meta property="og:image:height" content="{{ seo.image.height }}">
{%- endif %}
{%- endif %}
{%- if seo.article %}
<meta property="article:published_time" content="{{ seo.article.published }}">
{%- if seo.article.modified %}
<meta property="article:modified_time" content="{{ seo.article.modified }}">
{%- endif %}
<meta property="article:author" content="{{ site.author.url | default: site.url }}">
{%- for tag in seo.article.tags %}
<meta property="article:tag" content="{{ tag | escape }}">
{%- endfor %}
{%- endif %}

<meta name="twitter:card" content="{{ seo.twitterCard }}">

<script type="application/ld+json">{{ seo.jsonLd }}</script>
