# Credentials for `pnpm sync:standard-site`. Copy this file to .env (which is
# gitignored) and fill it in. See docs/standard-site.md.

# Your handle, e.g. you.bsky.social or example.com.
ATPROTO_HANDLE=
# An app password, not your account password.
ATPROTO_APP_PASSWORD=
# Only needed if your account is not hosted by Bluesky. Default: https://bsky.social
# ATPROTO_SERVICE=https://pds.example.com
